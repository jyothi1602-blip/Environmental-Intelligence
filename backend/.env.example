# Backend Environment Configuration
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# SQLite Database
DATABASE_URL=sqlite+aiosqlite:///./environmental_intel.db

# InfluxDB Configuration
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=my-super-secret-auth-token
INFLUXDB_ORG=env_intel_org
INFLUXDB_BUCKET=environmental_readings

# External API Keys (Leave blank or set to 'demo' to run in full Demo/Fallback mode)
OPENAQ_API_KEY=
WAQI_API_TOKEN=
OPENWEATHERMAP_API_KEY=
TOMTOM_API_KEY=
GOOGLE_MAPS_API_KEY=

# Default Fallback Coordinates (e.g. New Delhi / Hyderabad / Bangalore / London)
DEFAULT_LATITUDE=28.6139
DEFAULT_LONGITUDE=77.2090
DEFAULT_CITY=Delhi

